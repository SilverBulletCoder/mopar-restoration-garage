---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CudaProjectHeader from '../../../../components/CudaProjectHeader.astro';
import { cudaPhotoCategories, cudaPhotoGalleryPageSize } from '../../../../data/cuda-photo-galleries.js';

export function getStaticPaths() {
  const pages = [];
  for (const group of cudaPhotoCategories) {
    // Preserve smaller albums on one page; paginate the 32-image rear structure series.
    const pageSize = group.slug === 'rear-structure' ? cudaPhotoGalleryPageSize : group.photos.length;
    const count = Math.ceil(group.photos.length / pageSize);
    for (let page = 1; page <= count; page++) {
      pages.push({
        params: { category: page === 1 ? group.slug : `${group.slug}/${page}` },
        props: {
          group,
          page,
          pages: count,
          pagePhotos: group.photos.slice((page - 1) * pageSize, page * pageSize)
        }
      });
    }
  }
  return pages;
}
const { group, page, pages, pagePhotos } = Astro.props;
const groupUrl = (index) => `/builds/1973-cuda/photos/${group.slug}/${index === 1 ? '' : `${index}/`}`;
---
<BaseLayout
  title={group.title + ' | 1973 Plymouth ’Cuda | Mopar Restoration Garage'}
  description={group.description}
>
  <CudaProjectHeader active="photos" section={group.navLabel} />
  <div class="photo-header">
    <a class="back-link" href="/builds/1973-cuda/photos/">&larr; All photo collections</a>
    <h2>{group.title}</h2>
    <p>{group.description}</p>
    <p class="count">{group.photos.length} {group.photos.length === 1 ? 'photo' : 'photos'}{pages > 1 ? ` · Page ${page} of ${pages}` : ''}</p>
  </div>
  <nav class="photo-nav" aria-label="1973 Cuda photo collections">
    {cudaPhotoCategories.map((item) => (
      <a class={item.slug === group.slug ? "selected" : ""} aria-current={item.slug === group.slug ? 'page' : undefined} href={`/builds/1973-cuda/photos/${item.slug}/`}>{item.navLabel}</a>
    ))}
  </nav>
  <div class="photo-grid">
    {pagePhotos.map((photo) => (
      <figure class="photo-card">
        <a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size photo: ${photo.alt}`}>
          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
        </a>
        <figcaption>{photo.caption}</figcaption>
      </figure>
    ))}
  </div>
  {pages > 1 && (
    <nav class="page-nav" aria-label="Photo gallery pagination">
      {page > 1 ? <a href={groupUrl(page - 1)}>&larr; Previous</a> : <span class="disabled">Previous</span>}
      <div class="page-numbers">
        {Array.from({ length: pages }, (_, index) => index + 1).map((index) => (
          <a href={groupUrl(index)} aria-current={index === page ? 'page' : undefined} class={index === page ? "active" : ""}>{index}</a>
        ))}
      </div>
      {page < pages ? <a href={groupUrl(page + 1)}>Next &rarr;</a> : <span class="disabled">Next</span>}
    </nav>
  )}
</BaseLayout>
<style>
  .photo-header{margin-bottom:1.35rem}
  .photo-header .back-link{color:#ffbd72;text-decoration:none;font-weight:750}
  .photo-header .back-link:hover{text-decoration:underline}
  .photo-header h2{font-size:clamp(1.65rem,3vw,2.45rem);margin:.85rem 0 .5rem}
  .photo-header p{max-width:50rem;color:#c4ced1;line-height:1.6;margin:.55rem 0}
  .photo-header .count{color:#ffbd72;font-size:.9rem;font-weight:750}
  .photo-nav{display:flex;flex-wrap:wrap;gap:.55rem;margin:1.5rem 0 1.6rem}
  .photo-nav a{border:1px solid #475259;border-radius:8px;background:#293237;color:#f1f3f3;padding:.55rem .85rem;font-size:.9rem;font-weight:750;text-decoration:none}
  .photo-nav a:hover,.photo-nav a:focus-visible,.photo-nav a.selected{color:#fff1e6;border-color:#ffad72;background:#563a26}
  .photo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,275px),1fr));gap:1rem;margin-bottom:1.6rem}
  .photo-card{overflow:hidden;border-radius:12px;border:1px solid #485258;background:#20282d;margin:0}
  .photo-card a{display:block;background:#11181b}
  .photo-card a:focus-visible{outline:3px solid #ffad72;outline-offset:-3px}
  .photo-card img{display:block;width:100%;height:225px;object-fit:contain}
  .photo-card figcaption{padding:.85rem 1rem;color:#c9d1d5;line-height:1.5;font-size:.9rem}
  .page-nav{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin:2rem 0 3rem}
  .page-nav a,.disabled{display:inline-block;border:1px solid #505d64;border-radius:8px;padding:.55rem .8rem;font-size:.9rem;font-weight:750}
  .page-nav a{color:#ffbd72;text-decoration:none}
  .page-nav a:hover,.page-nav a:focus-visible,.page-nav a.active{background:#473426;border-color:#ffad72}
  .disabled{color:#78888e}
  .page-numbers{display:flex;gap:.45rem;flex-wrap:wrap}
  @media(max-width:520px){.photo-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.photo-card img{height:145px}.photo-card figcaption{font-size:.78rem;padding:.65rem}.page-nav{gap:.5rem}.page-nav a,.disabled{padding:.45rem .6rem}}
</style>
