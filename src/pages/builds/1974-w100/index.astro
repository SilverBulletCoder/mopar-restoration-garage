---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TruckProjectHeader from '../../../components/TruckProjectHeader.astro';
import TruckProjectDashboard from '../../../components/TruckProjectDashboard.astro';
import { truckProjects } from '../../../data/truck-projects.js';
const vehicle = truckProjects.find((project) => project.slug === '1974-w100');
---
<BaseLayout
  title={vehicle.name + ' | Mopar Restoration Garage'}
  description={'Explore the ' + vehicle.name + ' restoration, with dedicated pages for parts inventory, wishlist, photo galleries, and restoration checks.'}
>
  <TruckProjectHeader vehicle={vehicle} active="overview" />
  <TruckProjectDashboard vehicle={vehicle} />
</BaseLayout>
