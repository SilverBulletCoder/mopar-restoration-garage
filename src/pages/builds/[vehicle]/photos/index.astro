---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TruckProjectHeader from '../../../../components/TruckProjectHeader.astro';
import { truckProjects } from '../../../../data/truck-projects.js';
export function getStaticPaths() {
  return truckProjects.map((vehicle) => ({
    params: { vehicle: vehicle.slug },
    props: { vehicle }
  }));
}
const { vehicle } = Astro.props;
const root = `/builds/${vehicle.slug}/`;
const cudaPhotoCategories = vehicle.photoCategories;
const totalPhotos = cudaPhotoCategories.reduce((sum, group) => sum + group.photos.length, 0);
---
<BaseLayout
  title={vehicle.name + ' — Photo Galleries | Mopar Restoration Garage'}
  description={'Browse the ' + vehicle.name + ' restoration photographs by category.'}
>
  <TruckProjectHeader vehicle={vehicle} active="photos" section="Photo Galleries" />
  <section class="photo-intro">
    <p class="eyebrow">Restoration photos</p>
    <h2>Photo Galleries</h2>
    <p>Choose a photo collection to open just that section. The original images and photo numbers are preserved; no need to scroll through the entire project.</p>
    <p class="photo-count">{totalPhotos} photos across {cudaPhotoCategories.length} {cudaPhotoCategories.length === 1 ? 'collection' : 'collections'}</p>
  </section>
  <div class="photo-collections">
    {cudaPhotoCategories.map((group) => (
      <a class="collection-card" href={`${root}photos/${group.slug}/`}>
        <div class="collection-image">
          <img src={group.photos[0].src} alt={group.photos[0].alt} loading="lazy" decoding="async" />
        </div>
        <div class="collection-info">
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <span>{group.photos.length} {group.photos.length === 1 ? 'photo' : 'photos'} &rarr;</span>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
<style>
  .photo-intro{margin:0 0 1.5rem}
  .photo-intro h2{font-size:clamp(1.7rem,3vw,2.25rem);margin:.25rem 0 .7rem}
  .photo-intro p:not(.eyebrow){max-width:52rem;color:#c4cdd1;line-height:1.6;margin:.55rem 0}
  .photo-intro .photo-count{color:#ffbd72;font-weight:750}
  .photo-collections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;margin-bottom:3rem}
  .collection-card{display:flex;flex-direction:column;overflow:hidden;text-decoration:none;color:inherit;border:1px solid #47535a;border-radius:14px;background:#20282d;box-shadow:0 14px 30px #0003}
  .collection-card:hover,.collection-card:focus-visible{border-color:#ffad72;transform:translateY(-2px);outline:2px solid transparent}
  .collection-image{height:205px;background:#13191c}
  .collection-image img{width:100%;height:100%;object-fit:contain}
  .collection-info{padding:1.2rem 1.3rem}
  .collection-info h3{margin:0 0 .6rem;color:#f4f5f3;font-size:1.22rem}
  .collection-info p{margin:0 0 .8rem;color:#b9c4c8;line-height:1.55;font-size:.92rem}
  .collection-info span{color:#ffbd72;font-weight:750}
  @media(max-width:660px){.photo-collections{grid-template-columns:minmax(0,1fr)}.collection-image{height:185px}}
</style>
