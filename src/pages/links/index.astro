const slugify = (value) =>
  value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const groups = [...new Set(suppliers.map((supplier) => supplier.category))]
  .map((category) => ({
    name: category,
    id: slugify(category),
    suppliers: suppliers.filter((supplier) => supplier.category === category)
  }));
---

<BaseLayout
  title="Restoration References | Mopar Restoration Garage"
  description="Parts, suppliers, tools, and resources for our Mopar restoration projects."
>
  <section class="references-intro">
    <p class="eyebrow">Garage resources</p>
    <h1>Restoration References</h1>
    <p class="lead">Parts, suppliers, tools, and resources for our Mopar restoration projects.</p>
    <p class="intro-note">
      Visit a supplier's main website from its heading, or use the individual
      thumbnails below to open a specific product or parts collection.
      Confirm vehicle fitment and availability before ordering.
    </p>
  </section>

  <nav class="category-nav" aria-label="Reference categories">
    {groups.map((group) => <a href={'#' + group.id}>{group.name}</a>)}
  </nav>

  <div class="category-list">
    {groups.map((group) => (
      <section class="reference-category" id={group.id} aria-labelledby={group.id + '-heading'}>
        <div class="category-heading">
          <p class="eyebrow">Reference category</p>
          <h2 id={group.id + '-heading'}>{group.name}</h2>
        </div>

        <div class="supplier-list">
          {group.suppliers.map((supplier) => (
            <section class="supplier" aria-label={supplier.name}>
              <div class="supplier-heading">
                <div>
                  <h3>
                    <a href={supplier.homepage} target="_blank" rel="noopener noreferrer" aria-label={'Visit ' + supplier.name + ' homepage (opens in a new tab)'}>
                      {supplier.name} <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                  {supplier.description && <p>{supplier.description}</p>}
                </div>
                <a class="supplier-home" href={supplier.homepage} target="_blank" rel="noopener noreferrer">
                  Supplier website <span aria-hidden="true">↗</span>
                </a>
              </div>

              {supplier.references.length > 0 ? (
                <div class="product-grid">
                  {supplier.references.map((reference) => (
                    <article class="product-card">
                      <a class="thumbnail-link" href={reference.url} target="_blank" rel="noopener noreferrer" aria-label={'Open ' + reference.title + ' (new tab)'}>
                        {reference.image ? (
                          <img
                            src={reference.image}
                            alt={reference.imageAlt ?? reference.title}
                            width="112"
                            height="112"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span class="thumbnail-placeholder" aria-hidden="true">PART</span>
                        )}
                      </a>
                      <div class="product-details">
                        <h4>
                          <a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.title}</a>
                        </h4>
                        {reference.description && <p>{reference.description}</p>}
                        {reference.vehicleApplicability && <p class="vehicle-note">{reference.vehicleApplicability}</p>}
                        {reference.imageNote && <p class="image-note">{reference.imageNote}</p>}
                        <div class="product-actions">
                          <a class="product-link" href={reference.url} target="_blank" rel="noopener noreferrer">
                            {reference.linkLabel ?? 'View reference'} <span aria-hidden="true">↗</span>
                          </a>
                          {(reference.purchaseStatus || !reference.linkLabel?.startsWith('Browse')) && (
                            <span class="purchase-status">({reference.purchaseStatus ?? (supplier.category === 'Paint Suppliers' ? 'researching options' : 'Pending Purchased')})</span>
                          )}
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <p class="supplier-only-note">Supplier homepage reference — specific product links can be added here as needed.</p>
              )}
            </section>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .references-intro{max-width:820px;margin:1.5rem 0 2.4rem}
  h1{margin:.45rem 0 1rem;letter-spacing:-.04em}
  .lead{font-size:1.17rem;line-height:1.65;color:#edf0ef;margin:0 0 .9rem}
  .intro-note{font-size:1rem;line-height:1.7;color:#b7c0c2;margin:0}
  .category-nav{display:flex;flex-wrap:wrap;gap:.65rem;margin:0 0 2rem;padding:1rem;background:#191e21;border:1px solid #363d41;border-radius:14px}
  .category-nav a{display:inline-flex;align-items:center;padding:.65rem .85rem;border:1px solid #465057;border-radius:8px;color:#e7ecee;text-decoration:none;font-size:.9rem;font-weight:700}
  .category-nav a:hover,.category-nav a:focus-visible{border-color:#f47727;color:#ffbd72}
  .category-list{display:grid;gap:1.25rem}
  .reference-category{scroll-margin-top:1rem;background:#1b2023;border:1px solid #363d41;border-radius:16px;padding:1.5rem}
  .category-heading{border-bottom:1px solid #394146;padding-bottom:.9rem;margin-bottom:1.25rem}
  .category-heading h2{font-size:clamp(1.5rem,3vw,2.15rem);margin:.25rem 0}
  .supplier-list{display:grid;gap:1.3rem}
  .supplier{background:#202629;border:1px solid #41494e;border-radius:12px;padding:1.2rem;min-width:0}
  .supplier-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.1rem}
  .supplier-heading h3{font-size:1.27rem;margin:0 0 .3rem}
  .supplier-heading h3 a{color:#ffbd72;text-decoration:none}
  .supplier-heading h3 a:hover{text-decoration:underline;text-underline-offset:.2em}
  .supplier-heading p{color:#b7c0c2;line-height:1.5;margin:0;font-size:.94rem}
  .supplier-home{flex:none;padding:.6rem .8rem;border:1px solid #565e63;border-radius:8px;color:#e7ecee;font-size:.88rem;font-weight:700;text-decoration:none}
  .supplier-home:hover{border-color:#f47727;color:#ffbd72}
  .product-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:.8rem}
  .product-card{display:flex;gap:1rem;align-items:flex-start;background:#181e21;border:1px solid #3c454a;border-radius:10px;padding:.95rem;min-width:0}
  .product-card:focus-within{border-color:#f47727}
  .thumbnail-link{display:flex;align-items:center;justify-content:center;flex:none;width:112px;height:112px;overflow:hidden;background:#30383c;border:1px solid #4a555b;border-radius:8px}
  .thumbnail-link img{width:100%;height:100%;object-fit:contain;background:#2a3134}
  .thumbnail-placeholder{color:#94a2a8;letter-spacing:.1em;font-weight:800}
  .product-details{min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:.42rem;flex:1}
  .product-details h4{font-size:1.03rem;line-height:1.4;margin:0}
  .product-details h4 a{color:#f2f4f3;text-decoration:none}
  .product-details h4 a:hover{color:#ffbd72;text-decoration:underline}
  .product-details p{font-size:.87rem;line-height:1.5;color:#b7c0c2;margin:0}
  .product-details .vehicle-note{color:#e1bf99}
  .product-details .image-note{font-size:.76rem;font-style:italic;color:#a6b2b8}
  .product-actions{display:flex;align-items:center;flex-wrap:wrap;column-gap:.6rem;row-gap:.3rem;margin-top:.25rem}
  .product-link{color:#ffad72;font-size:.88rem;font-weight:750;text-decoration:none}
  .product-link:hover{text-decoration:underline;text-underline-offset:.2em}
  .purchase-status{font-size:.8rem;font-weight:650;color:#e5bd82;white-space:nowrap}
  .supplier-only-note{font-size:.9rem;color:#aebcc1;margin:0;line-height:1.6}
  a:focus-visible{outline:2px solid #ff954c;outline-offset:3px}
  @media(max-width:700px){
    .reference-category{padding:1.05rem}
    .supplier{padding:1rem}
    .product-grid{grid-template-columns:minmax(0,1fr)}
  }
  @media(max-width:440px){
    .category-nav{padding:.7rem}
    .category-nav a{font-size:.84rem}
    .lead{font-size:1.05rem}
    .product-card{gap:.75rem;padding:.75rem}
    .thumbnail-link{width:88px;height:88px}
    .supplier-home{width:100%;text-align:center}
  }
</style>
