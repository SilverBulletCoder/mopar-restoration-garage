---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Global directory: supplier homepages ONLY. Specific product links and
// research references are preserved separately in project-part-links.js.
const suppliers = [
  {
    "name": "Specialist Paints",
    "homepage": "https://usa.specialistpaints.com/",
    "category": "Paint Suppliers",
    "description": "Custom Paints Inc — automotive paint colors and finishes."
  },
  {
    "name": "Southern Polyurethanes (SPI)",
    "homepage": "https://www.southernpolyurethanes.com/",
    "category": "Paint Suppliers",
    "description": "Professional automotive epoxy primers and refinishing coatings."
  },
  {
    "name": "Tamco Paint",
    "homepage": "https://tamcopaint.com/",
    "category": "Paint Suppliers",
    "description": "Automotive epoxy primer and refinishing coating systems."
  },
  {
    "name": "SEM Products",
    "homepage": "https://semproducts.com/",
    "category": "Paint Suppliers",
    "description": "Automotive repair coatings and welding preparation products."
  },
  {
    "name": "AMK Products",
    "homepage": "https://www.amkproducts.com/",
    "category": "Hardware & Fasteners",
    "description": "Fastener kits and hardware for automotive restoration."
  },
  {
    "name": "Auto Metal Direct",
    "homepage": "https://www.autometaldirect.com/",
    "category": "Sheet Metal & Body Restoration",
    "description": "Replacement panels and sheet metal for classic vehicles."
  },
  {
    "name": "Detroit Muscle Technologies",
    "homepage": "https://www.detroitmuscletechnologies.com/",
    "category": "Restoration Parts & Components",
    "description": "Mopar and other classic vehicle restoration parts, gaskets, and components."
  }
];
const slugify = (name) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const groups = [...new Set(suppliers.map((supplier) => supplier.category))].map((name) => ({
  name,
  id: slugify(name),
  suppliers: suppliers.filter((supplier) => supplier.category === name)
}));
---
<BaseLayout
  title="Global Restoration Links | Mopar Restoration Garage"
  description="General automotive restoration suppliers and resource websites for the Mopar Restoration Garage."
>
  <section class="resources-intro">
    <p class="eyebrow">Mopar Restoration Garage / Global resources</p>
    <h1>Global Links</h1>
    <p class="lead">General supplier websites and restoration resources for every project in the garage.</p>
    <p class="intro-note">This directory links to supplier homepages, not individual products. Part-specific links and purchase research belong in each vehicle's <a href="/builds/">Parts Wishlist</a>.</p>
  </section>
  <nav class="category-nav" aria-label="Global resource categories">
    {groups.map((group) => <a href={'#' + group.id}>{group.name}</a>)}
  </nav>
  <div class="category-list">
    {groups.map((group) => (
      <section class="reference-category" id={group.id} aria-labelledby={group.id + '-title'}>
        <div class="category-heading">
          <p class="eyebrow">Resource category</p>
          <h2 id={group.id + '-title'}>{group.name}</h2>
        </div>
        <div class="supplier-grid">
          {group.suppliers.map((supplier) => (
            <article class="supplier-card">
              <div class="supplier-copy">
                <h3><a href={supplier.homepage} target="_blank" rel="noopener noreferrer">{supplier.name}</a></h3>
                <p>{supplier.description}</p>
              </div>
              <a class="site-link" href={supplier.homepage} target="_blank" rel="noopener noreferrer" aria-label={'Visit ' + supplier.name + ' website (opens in a new tab)'}>
                Visit website <span aria-hidden="true">&rarr;</span>
              </a>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
<style>
  .resources-intro{max-width:840px;margin:1.5rem 0 1.7rem}
  h1{margin:.45rem 0 .85rem;letter-spacing:-.04em}
  .lead{font-size:1.14rem;line-height:1.6;color:#edf0ef;margin:0 0 .65rem}
  .intro-note{font-size:.96rem;line-height:1.6;color:#b8c4c8;margin:0}
  .intro-note a{font-weight:750;color:#ffbd86}
  .category-nav{display:flex;flex-wrap:wrap;gap:.6rem;margin:0 0 1.55rem;padding:.8rem;background:#191e21;border:1px solid #394348;border-radius:12px}
  .category-nav a{display:inline-flex;align-items:center;padding:.5rem .8rem;border:1px solid #465057;border-radius:7px;color:#e7ecee;text-decoration:none;font-size:.87rem;font-weight:700}
  .category-nav a:hover,.category-nav a:focus-visible{border-color:#f47727;color:#ffbd72}
  .category-list{display:grid;gap:1rem;margin-bottom:2.5rem}
  .reference-category{scroll-margin-top:1rem;background:#1b2023;border:1px solid #3d484d;border-radius:14px;padding:1.35rem}
  .category-heading{margin-bottom:.9rem}
  .category-heading .eyebrow{margin:0}
  .category-heading h2{font-size:clamp(1.3rem,2.6vw,1.75rem);margin:.25rem 0}
  .supplier-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem}
  .supplier-card{display:flex;flex-direction:column;gap:.8rem;justify-content:space-between;min-width:0;background:#222a2e;border:1px solid #48545a;border-radius:11px;padding:1.1rem}
  .supplier-copy h3{font-size:1.1rem;margin:0 0 .45rem}
  .supplier-copy h3 a{color:#f5f6f5;text-decoration:none}
  .supplier-copy h3 a:hover{text-decoration:underline;color:#ffd1ab}
  .supplier-copy p{color:#bfc9cd;font-size:.9rem;line-height:1.55;margin:0}
  .site-link{display:inline-flex;align-items:center;gap:.35rem;align-self:flex-start;padding:.5rem .75rem;background:#493627;border:1px solid #855636;border-radius:7px;color:#ffca9d;font-size:.87rem;font-weight:750;text-decoration:none}
  .site-link:hover,.site-link:focus-visible{background:#5b3a25;border-color:#ffbd86;color:#ffe4cc}
  a:focus-visible{outline:2px solid #ffbd72;outline-offset:2px}
  @media(max-width:700px){.supplier-grid{grid-template-columns:minmax(0,1fr)}.reference-category{padding:1rem}.category-nav{padding:.6rem}}
</style>
